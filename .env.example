# Copy to .env (chmod 600) and fill in. Never commit .env.
# URL that receives the price alerts as a JSON POST:
TICKETS_WEBHOOK_URL=https://example.com/your-webhook
# Full value of the Authorization header sent with the POST:
TICKETS_WEBHOOK_AUTH=Bearer replace-me
# Local dashboard port (optional, default 8787; listens on 127.0.0.1 only):
# TICKETS_DASHBOARD_PORT=8787
